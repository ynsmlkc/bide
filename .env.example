# Bide sunucusu — ortam degiskenleri.
#
# Railway'de bunlar "Variables" sekmesine girilir. Bu dosya YALNIZCA ornek;
# gercek degerleri buraya YAZMA, `.env` git'e girmiyor ama bu dosya giriyor.

# ── zorunlu ──────────────────────────────────────────────────────

# Sunucunun herkese acik alan adi. NEP-413 imzasinin `recipient`'i bu:
# cuzdan kullaniciya "bu imza su uygulama icin" diye gosterir ve sunucu
# yalnizca bu alici icin uretilmis imzayi kabul eder. Basinda https:// YOK.
BIDE_HOME_DOMAIN=bide-production.up.railway.app

# IP hash'leme tuzu. Uretimde ZORUNLU — yoksa sunucu acilmaz. Rastgele ve gizli.
# Degistirilirse eski hash'ler eslesmez — fraud kurallari gecmisi kaybeder.
BIDE_IP_SALT=

# Kalici depolama. Railway'de bir Volume olusturup `/data`'ya baglayin.
# TANIMSIZ birakilirsa her sey BELLEKTE kalir ve her deploy'da bakiyeler
# silinir — sunucu acilista bunu gurultuyle uyarir.
BIDE_DB=/data/bide.db

# ── odeme (bunlar olmadan odeme KAPALI kalir) ────────────────────

# Treasury hesabi: `contracts/treasury` bu hesaba deploy edilmis olmali.
# Reklamveren yatirmalari onun kaydindan okunur, odemeler bu hesaptan cikar.
# Kurulum: node scripts/testnet-setup.mjs
BIDE_TREASURY_ACCOUNT=

# O hesabin TAM ERISIMLI anahtari (`ed25519:...`). Icinde odemeler icin USDC
# ve gaz icin biraz NEAR olmali.
BIDE_TREASURY_KEY=

# Platform paneli (`/v1/admin/*`) icin paylasilan sir. Cuzdan tabanli giris
# akisina girmiyor — ortada "admin cuzdani" diye bir kimlik yok, tipki
# BIDE_TREASURY_KEY gibi tek bir kisi (platform operatoru) kullaniyor.
# TANIMSIZ birakilirsa /v1/admin/* uclari hic acilmaz. Uret:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
BIDE_ADMIN_SECRET=

# ── istege bagli ─────────────────────────────────────────────────

# BIDE_NETWORK=testnet               # 'testnet' | 'mainnet'. mainnet'te dogrulama penceresi en az 1 saat
# BIDE_RPC=https://rpc.testnet.fastnear.com
# BIDE_USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af   # Circle USDC (testnet)
# BIDE_PENDING_MS=86400000           # dogrulama bekleme suresi. Uretimde varsayilan 24 saat,
#                                     # mainnet'te 1 saatin altindaki deger sunucuyu ACMAZ; testnet
#                                     # demoda kisaltilabilir (orn. 30000). Gelistirmede 30 sn.
# BIDE_MIN_CLIENT_VERSION=0.1.0      # ADR-016 surum kapisi; altindaki istemciler reddedilir
# BIDE_RECONCILE_MS=60000            # asili cekimlerin zincirle mutabakat araligi
# BIDE_DEPOSIT_INTERVAL_MS=20000     # treasury yatirma kaydinin tarama araligi
# BIDE_WALLET_HOLD_MS=259200000      # cuzdan degisikligi sonrasi bekleme (72 saat)
